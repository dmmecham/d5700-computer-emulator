@startuml D5700-Computer-Emulator
left to right direction
skinparam classAttributeIconSize 0

abstract class CpuCycleTemplate {
  +step(): Unit
  #beforeStep(): Unit
  #fetchInstruction(): Int
  #executeInstruction(instruction: Int): Unit
  #afterStep(): Unit
}

class D5700CPU {
  +registers: UByteArray
  +programCounter: Int
  +addressRegister: Int
  +memorySelectRom: Boolean
  +halted: Boolean
  +reset(): Unit
  #fetchInstruction(): Int
  #executeInstruction(instruction: Int): Unit
  #afterStep(): Unit
}

class D5700Emulator {
  -cpu: D5700CPU
  -rom: D5700Rom
  -display: D5700Display
  -timer: D5700Timer
  +loadRom(bytes: UByteArray): Unit
  +reset(): Unit
  +run(): Unit
  +create(keyboardInput: KeyboardInput, timerScheduler: TimerSchedulerStrategy, romWritable: Boolean, display: D5700Display, instructionFactory: InstructionFactory): D5700Emulator
}

note right of D5700Emulator
  companion object Factory
end note

object D5700App {
  +run(): Unit
}

object D5700RomLoader {
  +loadFromPath(path: String): UByteArray
}

interface InstructionFactory {
  +get(opcode: Int): InstructionStrategy?
}

fun interface InstructionStrategy {
  +execute(cpu: D5700CPU, instruction: Int): Unit
}

abstract class AbstractInstructionFamily {
  +execute(cpu: D5700CPU, instruction: Int): Unit
  #decodeOperands(instruction: Int): InstructionOperands
  #executeWithOperands(cpu: D5700CPU, operands: InstructionOperands): Unit
}

data class InstructionOperands {
  +registerX: Int
  +registerY: Int
  +registerZ: Int
  +address: Int
  +immediateByte: Int
}

object DefaultInstructionFactory {
  -instructionMap: Map<Int, InstructionStrategy>
  +get(opcode: Int): InstructionStrategy?
}

interface D5700AddressableMemory {
  +size: Int
  +read(address: Int): UByte
  +write(address: Int, value: UByte): Unit
}

class D5700Ram {
  -storage: UByteArray
  +size: Int
  +read(address: Int): UByte
  +write(address: Int, value: UByte): Unit
  +clear(): Unit
}

class D5700Rom {
  -storage: UByteArray
  +size: Int
  +load(bytes: UByteArray): Unit
  +read(address: Int): UByte
  +write(address: Int, value: UByte): Unit
}

interface KeyboardInput {
  +readHexByte(): UByte
}

class ConsoleKeyboardInput {
  +readHexByte(): UByte
  -parseHexInput(raw: String): UByte
}

class StubKeyboardInput {
  +readHexByte(): UByte
}

interface DisplayRenderer {
  +render(buffer: UByteArray, force: Boolean): Unit
}

class ConsoleDisplayRenderer {
  +render(buffer: UByteArray, force: Boolean): Unit
}

class D5700Display {
  -frameBuffer: UByteArray
  -dirty: Boolean
  +draw(row: Int, column: Int, value: UByte): Unit
  +clear(): Unit
  +snapshot(): UByteArray
  +render(force: Boolean = false): Unit
  +renderToConsole(force: Boolean = false): Unit
}

interface TimerSchedulerStrategy {
  +start(onTick: () -> Unit): AutoCloseable
}

class RealTimeTimerSchedulerStrategy {
  +start(onTick: () -> Unit): AutoCloseable
}

class ManualTimerSchedulerStrategy {
  +start(onTick: () -> Unit): AutoCloseable
  +tick(times: Int = 1): Unit
}

class D5700Timer {
  +start(): Unit
  +stop(): Unit
  +set(newValue: UByte): Unit
  +get(): UByte
  +tick60Hz(): Unit
}

class D5700Exception
class ProgramTerminatedException
class InvalidInstructionException
class MemoryAccessException
class RomWriteException

D5700App --> D5700RomLoader : loads program
D5700App --> D5700Emulator : starts
D5700App ..> D5700Emulator : create(...)

D5700Emulator o-- D5700CPU
D5700Emulator o-- D5700Rom
D5700Emulator o-- D5700Display
D5700Emulator o-- D5700Timer
D5700Emulator ..> KeyboardInput : accepts
D5700Emulator ..> TimerSchedulerStrategy : accepts
D5700Emulator ..> D5700Display : accepts
D5700Emulator ..> InstructionFactory : accepts

CpuCycleTemplate <|-- D5700CPU

D5700CPU --> D5700Rom : fetches instructions
D5700CPU --> D5700Ram : data memory
D5700CPU --> KeyboardInput : reads input
D5700CPU --> D5700Display : draws output
D5700CPU --> D5700Timer : reads/sets timer
D5700CPU --> InstructionFactory : decodes/dispatches

InstructionFactory <|.. DefaultInstructionFactory
InstructionStrategy <.. DefaultInstructionFactory : uses
AbstractInstructionFamily <|-- LoadImmediateInstruction
AbstractInstructionFamily <|-- AddInstruction
AbstractInstructionFamily <|-- SubtractInstruction
AbstractInstructionFamily <|-- ReadMemoryInstruction
AbstractInstructionFamily <|-- WriteMemoryInstruction
AbstractInstructionFamily <|-- JumpInstruction
AbstractInstructionFamily <|-- ReadKeyboardInstruction
AbstractInstructionFamily <|-- ToggleMemorySelectionInstruction
AbstractInstructionFamily <|-- SkipIfEqualInstruction
AbstractInstructionFamily <|-- SkipIfNotEqualInstruction
AbstractInstructionFamily <|-- SetAddressInstruction
AbstractInstructionFamily <|-- SetTimerInstruction
AbstractInstructionFamily <|-- ReadTimerInstruction
AbstractInstructionFamily <|-- ConvertToBase10Instruction
AbstractInstructionFamily <|-- ConvertByteToAsciiInstruction
AbstractInstructionFamily <|-- DrawInstruction

D5700AddressableMemory <|.. D5700Ram
D5700AddressableMemory <|.. D5700Rom

KeyboardInput <|.. ConsoleKeyboardInput
KeyboardInput <|.. StubKeyboardInput

DisplayRenderer <|.. ConsoleDisplayRenderer
D5700Display --> DisplayRenderer : uses

TimerSchedulerStrategy <|.. RealTimeTimerSchedulerStrategy
TimerSchedulerStrategy <|.. ManualTimerSchedulerStrategy
D5700Timer --> TimerSchedulerStrategy : uses

D5700Exception <|-- ProgramTerminatedException
D5700Exception <|-- InvalidInstructionException
D5700Exception <|-- MemoryAccessException
D5700Exception <|-- RomWriteException
@enduml
